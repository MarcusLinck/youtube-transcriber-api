{
  "name": "youtube-transcriber-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --env-file=.env --import=tsx --watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "node --import=tsx --test \"tests/**/*.test.ts\"",
    "test:unit": "node --import=tsx --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --import=tsx --test \"tests/integration/**/*.test.ts\"",
    "test:e2e": "node --import=tsx --test \"tests/e2e/**/*.test.ts\"",
    "test:coverage": "node --import=tsx --test --experimental-test-coverage \"tests/**/*.test.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@ai-sdk/google": "^4.0.74",
    "@fastify/swagger": "^9.8.1",
    "@fastify/type-provider-zod": "^1.0.0",
    "@mastra/core": "^1.67.0",
    "@scalar/fastify-api-reference": "^1.68.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.8",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^6.0.1",
    "pg": "^8.23.0",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
